{
  "watch": [
    "bin",
    "packages/**/bin",
    "packages/**/scripts",
    "packages/**/src",
    "scripts",
    "src",
    ".env.development"
  ],
  "ext": ".ts,.tsx,.json",
  "ignore": ["src/**/*.spec.ts"],
  "exec": "node --env-file=.env.development --loader ts-node/esm/transpile-only ./src/bin/www.ts"
}
